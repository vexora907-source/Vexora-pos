{
  "manifest_version": 2,
  "name": "Vexora POS Print",
  "version": "1.0.0",
  "description": "Impresión ESC/POS directa para Vexora POS en Firefox.",
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://vexoraia.com/*",
        "https://*.vexoraia.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vexora-print@vexoraia.com",
      "strict_min_version": "102.0"
    }
  }
}
